rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isAuthenticated() {
      return request.auth != null;
    }
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }
    function isAdmin() {
      return isAuthenticated() &&
        ((exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
          get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin') ||
         (request.auth.token.email == "juliano.mrodrigues@goias.gov.br"));
    }
    // Permissão individual concedida na aba "Gestão de Usuários" (ex: canAccessUpload).
    function hasPermission(field) {
      return isAuthenticated() &&
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data[field] == true;
    }

    // ── Usuários ─────────────────────────────────────────────
    match /users/{userId} {
      // Qualquer autenticado pode ler (necessário para o painel de gestão)
      allow read: if isAuthenticated();
      // Usuário cria o próprio documento no login OU admin cria para qualquer usuário
      allow create: if isAuthenticated() && (isOwner(userId) || isAdmin());
      // Usuário atualiza o próprio doc (exceto role); admin atualiza qualquer campo
      allow update: if isAuthenticated() && (
        (isOwner(userId) && request.resource.data.role == resource.data.role) ||
        isAdmin()
      );
      allow delete: if isAdmin();
    }

    // ── Itens do Plano de Trabalho (orçamento) ──────────────────
    match /budgetItems/{itemId} {
      allow read: if isAuthenticated();
      allow create, update, delete: if isAdmin();
    }

    // ── Configurações da parceria (dados fixos do relatório final) ─
    match /settings/{docId} {
      allow read: if isAuthenticated();
      allow create, update: if isAdmin();
      allow delete: if false;
    }

    // ── Ledger ───────────────────────────────────────────────
    match /ledger/{entryId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated();
      allow update: if isAuthenticated() && (isOwner(resource.data.authorUid) || isAdmin());
      allow delete: if isAdmin();
    }

    // ── Audit ────────────────────────────────────────────────
    match /audit/{logId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated();
      allow update, delete: if false;
    }

    // ── Monitor de Aprendizes — dimensão "Apuração Mensal" ──────
    // Metadados de cada período importado via CSV.
    match /periodos/{periodoId} {
      allow read: if isAuthenticated();
      allow create, update, delete: if isAdmin() || hasPermission('canAccessUpload');
    }

    // Uma coleção por período, ex: colaboradores_2026_04. O Firestore não
    // permite misturar prefixo fixo com variável num único segmento do
    // caminho, então usamos um curinga genérico de coleção e filtramos
    // pelo prefixo do nome dentro da condição.
    match /{collectionId}/{colaboradorId} {
      allow read: if collectionId.matches('colaboradores_.*') && isAuthenticated();
      allow create, update, delete: if collectionId.matches('colaboradores_.*') &&
        (isAdmin() || hasPermission('canAccessUpload'));
    }
  }
}
